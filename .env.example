# Copy this file to .env and edit. Every value below is read at startup.

# ------------------------------------------------------------------ the model
# ollama = a small model on your own laptop (free, private, no internet needed)
# openai = any OpenAI-compatible server (OpenAI, Groq, Sarvam, vLLM, LM Studio)
# stub   = no model; canned replies, useful to click through the UI
LLM_PROVIDER=ollama

# ollama settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# openai-compatible settings (only used when LLM_PROVIDER=openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# ------------------------------------------------------------------- tutoring
TUTOR_NAME=StudyMate
MAX_REPLY_TOKENS=900
HISTORY_MESSAGES=12
REQUEST_TIMEOUT=180

# ---------------------------------------------------------------- class notes
RAG_TOP_K=4
RAG_CHUNK_CHARS=900
MAX_UPLOAD_MB=15

# -------------------------------------------------------------------- account
ALLOW_SIGNUP=1
# Set a secret here if teachers must enter a code to register as teachers.
TEACHER_CODE=
SESSION_DAYS=30
RATE_LIMIT_PER_MIN=20

# ------------------------------------------------- phones / wrappers (CORS)
# Comma-separated origins allowed to call the API from another app or site,
# e.g. https://localhost,capacitor://localhost,https://portal.school.in
# Leave empty when the UI is served by this same server.
ALLOWED_ORIGINS=

# ------------------------------------------------------------------- storage
# DATA_DIR=./data
# DB_FILE=tutor.db
